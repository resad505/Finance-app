                <mxCell id="15" value="&lt;b&gt;Database Relational Schema (Cents Standard)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;• accounts:&lt;/b&gt; id, name, type, currency, balance_cents, updated_at&lt;br&gt;&lt;b&gt;• transactions:&lt;/b&gt; id, account_id, category_id, amount_cents, payee, date, fingerprint&lt;br&gt;&lt;b&gt;• categories:&lt;/b&gt; id, name, group_id, monthly_budget_cents, color&lt;br&gt;&lt;b&gt;• rules:&lt;/b&gt; id, priority, conditions_json, actions_json, is_active&lt;br&gt;&lt;b&gt;• import_batches:&lt;/b&gt; id, filename, file_hash, imported_rows, created_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e9d5ff;align=center;verticalAlign=top;spacingTop=6;shadow=1;" parent="13" vertex="1">
                    <mxGeometry x="290" y="55" width="490" height="145" as="geometry"/>
