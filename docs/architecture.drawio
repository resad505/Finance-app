                <mxCell id="18" value="&lt;b&gt;Docker Containerization&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;• Multi-stage &lt;code&gt;Dockerfile&lt;/code&gt;&lt;br&gt;  - Base (Node 20 Alpine)&lt;br&gt;  - Deps (pnpm prune)&lt;br&gt;  - Builder (Next.js standalone)&lt;br&gt;  - Runner (unprivileged user)&lt;br&gt;• Minimal image size (&amp;lt; 160MB)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffedd5;align=center;verticalAlign=top;spacingTop=6;shadow=1;" parent="17" vertex="1">
                    <mxGeometry x="25" y="55" width="260" height="150" as="geometry"/>
