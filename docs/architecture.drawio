                <mxCell id="19" value="&lt;b&gt;Docker Compose Orchestration&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;• &lt;code&gt;docker-compose.yml&lt;/code&gt;&lt;br&gt;• Named persistent volumes:&lt;br&gt;  &lt;code&gt;./finance_data:/data&lt;/code&gt;&lt;br&gt;• Port binding (3000:3000)&lt;br&gt;• Container health check endpoints&lt;br&gt;• Restart policy: &lt;code&gt;unless-stopped&lt;/code&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffedd5;align=center;verticalAlign=top;spacingTop=6;shadow=1;" parent="17" vertex="1">
