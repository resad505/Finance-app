                <mxCell id="16" value="&lt;b&gt;Storage Engine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7e22ce&quot;&gt;[Persistent Volume]&lt;/font&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;• &lt;b&gt;SQLite File (Local-First)&lt;/b&gt;&lt;br&gt;  Path: &lt;code&gt;/data/finance.db&lt;/code&gt;&lt;br&gt;  (WAL mode enabled for speed)&lt;br&gt;• &lt;i&gt;Or PostgreSQL&lt;/i&gt; (Dual-engine)&lt;br&gt;• Automated SQLite backup cron&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#e9d5ff;align=center;verticalAlign=top;spacingTop=4;shadow=1;" parent="13" vertex="1">
