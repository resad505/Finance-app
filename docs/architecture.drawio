                <mxCell id="14" value="&lt;b&gt;Drizzle ORM &amp;amp; Client&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7e22ce&quot;&gt;[Dev 1]&lt;/font&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;• Type-safe Queries &amp;amp; Relations&lt;br&gt;• Schema Migrations (&lt;code&gt;drizzle-kit&lt;/code&gt;)&lt;br&gt;• Connection Pooling (WAL mode)&lt;br&gt;• Drizzle-Zod Type Inferencing&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e9d5ff;align=center;verticalAlign=top;spacingTop=6;shadow=1;" parent="13" vertex="1">
