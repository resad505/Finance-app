    <mxCell id="phase2" value="&lt;b&gt;PHASE 2: Data Modeling &amp;amp; Local-First Storage&lt;/b&gt; (Sprint 2)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f0fdf4;strokeColor=#22c55e;fontColor=#15803d;fontSize=13;rounded=1;arcSize=6;" vertex="1" parent="1">
