    <mxCell id="p1_t1" value="&lt;b&gt;Task 1.1: Project Scaffolding &amp;amp; Tooling&lt;/b&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;• Setup Vite + React 19 + TypeScript (Strict mode)&lt;br&gt;• Configure ESLint, Prettier &amp;amp; path aliases (&lt;code&gt;@/*&lt;/code&gt;)&lt;br&gt;&lt;font color=&quot;#2563eb&quot;&gt;💡 Learning: Modern Bundling, Strict Types &amp;amp; tsconfig aliases&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" vertex="1" parent="phase1">
      <mxGeometry x="20" y="45" width="500" height="55" as="geometry"/>
    </mxCell>

    <mxCell id="p1_t2" value="&lt;b&gt;Task 1.2: Tailwind CSS &amp;amp; Glassmorphism Theme&lt;/b&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;• Define CSS variables for Dark/Light mode theme switching&lt;br&gt;• Create Glassmorphism utility classes (&lt;code&gt;backdrop-blur-md&lt;/code&gt;, border glow)&lt;br&gt;&lt;font color=&quot;#2563eb&quot;&gt;💡 Learning: CSS Custom Properties &amp;amp; HSL-based Design Tokens&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" vertex="1" parent="phase1">
      <mxGeometry x="20" y="110" width="500" height="55" as="geometry"/>
    </mxCell>

    <mxCell id="p1_t3" value="&lt;b&gt;Task 1.3: Core shadcn/ui &amp;amp; Radix Primitives&lt;/b&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;• Install Button, Input, Card, Dialog, Dropdown &amp;amp; Sonner Toast&lt;br&gt;• Configure &lt;code&gt;cn()&lt;/code&gt; helper (clsx + tailwind-merge) &amp;amp; Lucide Icons&lt;br&gt;&lt;font color=&quot;#2563eb&quot;&gt;💡 Learning: Headless Component Architecture &amp;amp; WAI-ARIA Accessibility&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" vertex="1" parent="phase1">
