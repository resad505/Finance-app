    <mxCell id="p3_t1" value="&lt;b&gt;Task 3.1: Glassmorphism Sidebar &amp;amp; Mobile Drawer&lt;/b&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;• Collapsible desktop sidebar with active route indicator&lt;br&gt;• Mobile slide-out drawer with focus trap &amp;amp; keyboard escape support&lt;br&gt;&lt;font color=&quot;#7c3aed&quot;&gt;💡 Learning: Responsive App Shell Patterns &amp;amp; Mobile UX Standards&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" vertex="1" parent="phase3">
      <mxGeometry x="20" y="45" width="500" height="60" as="geometry"/>
