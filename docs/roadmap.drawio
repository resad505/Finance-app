    <mxCell id="phase1" value="&lt;b&gt;PHASE 1: Foundations &amp;amp; Design System Setup&lt;/b&gt; (Sprint 1)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e40af;fontSize=13;rounded=1;arcSize=6;" vertex="1" parent="1">
