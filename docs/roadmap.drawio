    <mxCell id="header" value="&lt;b style=&quot;font-size:18px;&quot;&gt;Finance Control — Step-by-Step Frontend Engineering Roadmap&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px;&quot;&gt;Sequential Phase Breakdown, Task Dependencies &amp;amp; Pair-Programming Learning Milestones&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
