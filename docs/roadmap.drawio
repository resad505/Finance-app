    <mxCell id="gp_roles" value="&lt;b&gt;How You &amp;amp; Teammate Collaborate&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Developer A (resad505):&lt;/b&gt;&lt;br&gt;• Focus on UI Markup, Glassmorphism CSS, Tailwind Layout, shadcn/ui integration &amp;amp; Accessibility (a11y).&lt;br&gt;&lt;br&gt;&lt;b&gt;Developer B (Possible-o):&lt;/b&gt;&lt;br&gt;• Focus on Dexie.js schema, TanStack Query hooks, Cents math models &amp;amp; CSV parsing logic.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pair Together on:&lt;/b&gt;&lt;br&gt;• TanStack Table virtual wiring &amp;amp; Recharts data transformation hooks.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=center;verticalAlign=top;spacingTop=6;shadow=1;" vertex="1" parent="guide_panel">
      <mxGeometry x="20" y="45" width="300" height="185" as="geometry"/>
    </mxCell>

    <mxCell id="gp_rules" value="&lt;b&gt;Pair-Programming Golden Rules&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;1. &lt;b&gt;Feature Branches:&lt;/b&gt; Never commit directly to &lt;code&gt;main&lt;/code&gt;. Each task gets a branch (e.g. &lt;code&gt;feat/task-1.2-tailwind-theme&lt;/code&gt;).&lt;br&gt;&lt;br&gt;2. &lt;b&gt;Code Reviews on PRs:&lt;/b&gt; One developer creates the PR, the other reviews and approves.&lt;br&gt;&lt;br&gt;3. &lt;b&gt;Senior Mentor Assistance:&lt;/b&gt; Whenever you get stuck on a concept, ask me — I guide the logic, explain edge cases, and refine the UI with you!&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=center;verticalAlign=top;spacingTop=6;shadow=1;" vertex="1" parent="guide_panel">
      <mxGeometry x="20" y="245" width="300" height="210" as="geometry"/>
    </mxCell>

    <mxCell id="gp_milestones" value="&lt;b&gt;Key Deliverable Milestones&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;🏆 M1 (End of Phase 2):&lt;/b&gt;&lt;br&gt;Working local database in browser with 200+ simulated transactions.&lt;br&gt;&lt;br&gt;&lt;b&gt;🏆 M2 (End of Phase 4):&lt;/b&gt;&lt;br&gt;Fully interactive 60fps Ledger with search, filters, and instant add/delete.&lt;br&gt;&lt;br&gt;&lt;b&gt;🏆 M3 (End of Phase 6):&lt;/b&gt;&lt;br&gt;Production-ready self-hosted app with CSV sync, FIRE calculator &amp;amp; 1-click backup.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=center;verticalAlign=top;spacingTop=6;shadow=1;" vertex="1" parent="guide_panel">
      <mxGeometry x="20" y="470" width="300" height="200" as="geometry"/>
    </mxCell>

