    <mxCell id="phase5" value="&lt;b&gt;PHASE 5: Financial Analytics &amp;amp; FIRE Engine&lt;/b&gt; (Sprint 5)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#fefce8;strokeColor=#eab308;fontColor=#854d0e;fontSize=13;rounded=1;arcSize=6;" vertex="1" parent="1">
